# oe-demo-frontend — serve the SPA + reverse-proxy /api to the backend.
#
# The backend address is an ENVIRONMENT VARIABLE (BACKEND_UPSTREAM = host:port), substituted into this
# file at container start by the nginx image's envsubst step. Set it per environment:
#     local Docker Desktop : BACKEND_UPSTREAM=host.docker.internal:8000   (reaches the backend on your host)
#     k8s / prod           : BACKEND_UPSTREAM=atom-oer-api:8000           (the backend Service name : port)
# NEVER hardcode host.docker.internal — that name only exists on Docker Desktop and breaks in prod.
server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # runtime config — rewritten from env at container start, so it must NEVER be cached (always fresh per deploy)
    location = /config.js {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # static assets + SPA client-side routing (unknown paths fall back to index.html)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API reverse proxy -> backend (same-origin for the browser, so no CORS).
    # BACKEND_UPSTREAM defaults to a literal IP (127.0.0.1:8000) so nginx STARTS even before any backend
    # exists — it just returns 502 on /api until you set BACKEND_UPSTREAM to the real backend Service.
    # (A hostNAME default like host.docker.internal fails DNS at startup and crash-loops the whole pod.)
    location /api/ {
        proxy_pass         http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # long-cache hashed build assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
